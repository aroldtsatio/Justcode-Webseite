# Server-only secrets. Never prefix these variables with VITE_.
# Use a separate Neon database/branch for local development and Vercel previews.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require
SITE_ORIGIN=http://localhost:5173
# Generate using: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

